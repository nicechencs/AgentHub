{
  "name": "agenthub",
  "private": true,
  "version": "0.3.2",
  "description": "Multi-agent desktop hub: install runtimes, manage providers/accounts, skills, usage, and chat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicechencs/AgentHub.git"
  },
  "bugs": {
    "url": "https://github.com/nicechencs/AgentHub/issues"
  },
  "homepage": "https://github.com/nicechencs/AgentHub#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:macos": "./run.sh",
    "dev:linux": "./run.sh",
    "build": "tsc -p tsconfig.app.json --pretty false && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --pretty false",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "vitest run src/dev/mocks/adapter.test.ts src/lib/backend/boundary-imports.test.ts src/lib/api/backend-features.test.ts",
    "test:bridge": "cargo test -p agenthub-core --locked bridge && cargo test -p agenthub-gui --locked adapter_bridge_controller",
    "test:pr": "pnpm typecheck && pnpm typecheck:test && pnpm test && cargo test -p agenthub-core --locked",
    "pricing:update": "node scripts/update-embedded-pricing.mjs",
    "pricing:check": "node scripts/update-embedded-pricing.mjs --check",
    "icons": "node scripts/generate-desktop-icons.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:macos": "tauri build --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "tauri:build:linux": "tauri build --bundles deb,appimage --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "updater:latest-json": "node scripts/build-latest-json.mjs",
    "release:check": "node scripts/release-metadata.mjs",
    "release:test": "node --test scripts/release-metadata.test.mjs scripts/build-latest-json.test.mjs scripts/check-linux-prereqs.test.mjs",
    "release:update": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-update.ps1",
    "release:bump": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-update.ps1 -BumpPatch -VersionOnly",
    "release:bump:minor": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-update.ps1 -BumpMinor -VersionOnly",
    "release:bump:major": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-update.ps1 -BumpMajor -VersionOnly",
    "release:update:publish": "node -e \"console.error('Local publishing is disabled; push a matching v* tag after updating the release branch and let .github/workflows/release.yml publish the release.'); process.exit(1)\""
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.4.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/react-codemirror": "^4.23.6",
    "@uiw/react-markdown-preview": "^5.2.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "rehype-raw": "^7.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
